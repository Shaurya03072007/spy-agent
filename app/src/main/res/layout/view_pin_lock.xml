<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pinLockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FA0B0E14"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Glowing Cyber Lock Icon -->
    <ImageView
        android:id="@+id/ivLockIcon"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:src="@drawable/ic_lock"
        app:tint="@color/accent_cyan"
        android:contentDescription="Security Lock" />

    <TextView
        android:id="@+id/tvPinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ACCESS RESTRICTED"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/tvPinSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Enter 4-digit security PIN to unlock ADB"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- 4 PIN Dots Indicator -->
    <LinearLayout
        android:id="@+id/layoutPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot" />

        <View
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot" />

        <View
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot" />

        <View
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pin_dot" />
    </LinearLayout>

    <!-- Keypad Matrix (3x4) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey1"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_keypad_btn"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey2"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_keypad_btn"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey3"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_keypad_btn"
                android:text="3"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey4"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_keypad_btn"
                android:text="4"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey5"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_keypad_btn"
                android:text="5"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey6"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_keypad_btn"
                android:text="6"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: 7, 8, 9 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey7"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_keypad_btn"
                android:text="7"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey8"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_keypad_btn"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey9"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_keypad_btn"
                android:text="9"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4: Clear/Cancel, 0, Backspace -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKeyClear"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="CLR"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKey0"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_pin_keypad_btn"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnKeyBackspace"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clear"
                app:tint="@color/accent_cyan"
                android:contentDescription="Backspace" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
